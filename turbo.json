{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**"]
		},
		"transit": {
			"dependsOn": ["^transit"]
		},
		"lint:eslint": {
			"dependsOn": ["transit"]
		},
		"lint:eslint:fix": {
			"dependsOn": ["transit"],
			"cache": false
		},
		"//#lint:oxlint": {},
		"//#lint:oxlint:fix": {
			"cache": false
		},
		"//#format": {},
		"//#format:fix": {
			"cache": false
		},
		"type-check": {
			"dependsOn": ["transit"]
		},
		"test": {
			"dependsOn": ["transit"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
