{
	"$schema": "https://mintlify.com/docs.json",
	"theme": "maple",
	"name": "Velumn Docs",
	"colors": {
		"primary": "#a855f7",
		"light": "#07C983",
		"dark": "#15803D"
	},
	"favicon": "/favicon.ico",
	"navigation": {
		"tabs": [
			{
				"tab": "Guides",
				"groups": [
					{
						"group": "Getting started",
						"pages": ["index", "troubleshooting", "privacy"]
					}
				]
			}
		],
		"global": {
			"anchors": [
				{
					"anchor": "Discord",
					"href": "https://velumn.com/discord",
					"icon": "discord"
				}
			]
		}
	},
	"logo": {
		"dark": "./logo.svg",
		"light": "./logo.svg"
	},
	"navbar": {
		"primary": {
			"type": "button",
			"label": "Website",
			"href": "https://velumn.com"
		}
	},
	"contextual": {
		"options": [
			"copy",
			"view",
			"chatgpt",
			"claude",
			"perplexity",
			"mcp",
			"cursor",
			"vscode"
		]
	},
	"footer": {
		"socials": {
			"github": "https://github.com/lmssiehdev/velumn",
			"discord": "https://velumn.com/discord"
		}
	}
}
