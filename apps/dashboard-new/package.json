{
  "name": "dashboard-new",
  "private": true,
  "type": "module",
  "scripts": {
    "with-env": "bun --env-file=.env.local --env-file=../../.env",
    "dev": "bun with-env run vite dev --port 3001",
    "build": "bun run type-check && bun with-env run vite build",
    "build:vercel": "bun run type-check && NITRO_PRESET=vercel bun with-env run vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:production-isolation": "bun with-env run scripts/check-production-isolation.mjs",
    "billing:repair": "bun with-env run scripts/billing-repair.ts",
    "verify:production": "bun run build:vercel && bun run test:production-isolation",
    "lint": "oxlint --deny-warnings . && eslint --max-warnings 0",
    "lint:oxlint": "oxlint --deny-warnings .",
    "lint:eslint": "eslint --max-warnings 0",
    "lint:fix": "oxlint --fix . && eslint --fix",
    "lint:eslint:fix": "eslint --fix",
    "format": "oxfmt .",
    "check": "oxfmt --check .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/api": "workspace:*",
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@polar-sh/better-auth": "1.8.4",
    "@polar-sh/sdk": "0.49.0",
    "@repo/db": "workspace:*",
    "@repo/utils": "workspace:*",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "0.10.9",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "1.170.23",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.40",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "1.168.27",
    "@trpc/client": "11.15.0",
    "@vercel/sdk": "^1.19.11",
    "better-auth": "1.5.6",
    "better-result": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "discord-api-types": "^0.38.31",
    "lucide-react": "^1.28.0",
    "nitro": "3.0.260610-beta",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rehype-slug": "^6.0.0",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "takumi-js": "^2.6.1",
    "tw-animate-css": "^1.4.0",
    "tocbot": "^4.36.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@tanstack/devtools-vite": "0.8.3",
    "@tanstack/eslint-config": "0.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22",
    "@types/mdx": "^2.0.13",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^9",
    "jsdom": "^28",
    "typescript": "^6",
    "vite": "^8",
    "vitest": "^4"
  }
}
