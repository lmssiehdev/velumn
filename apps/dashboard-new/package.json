{
  "name": "dashboard-new",
  "private": true,
  "type": "module",
  "scripts": {
    "with-env": "bun --env-file=../../.env --env-file=.env.local",
    "dev": "bun with-env run vite dev --port 3001",
    "build": "bun run typecheck && bun with-env run vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@repo/db": "workspace:*",
    "@repo/utils": "workspace:*",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "0.10.9",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.35",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "1.168.23",
    "@trpc/client": "^11.7.1",
    "@vercel/sdk": "^1.19.11",
    "better-auth": "1.5.6",
    "better-result": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
