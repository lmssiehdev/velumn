{
  "$schema": "../../node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "ignorePatterns": [".output/**", ".vercel/**", "src/routeTree.gen.ts"],
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "src/globals.css",
    "functions": ["cn", "cva"]
  }
}
