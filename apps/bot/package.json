{
	"name": "bot",
	"type": "module",
	"main": "src/main.ts",
	"scripts": {
		"dev": "NODE_ENV=development bun --env-file=../../.env --watch src/main.ts",
		"start": "NODE_ENV=production bun --env-file=../../.env src/main.ts",
		"test": "bun run test:unit && bun run test:effect",
		"test:unit": "bun test tests",
		"test:effect": "vitest run src",
		"test:effect:watch": "vitest src",
		"type-check": "tsc --noEmit"
	},
	"devDependencies": {
		"@effect/vitest": "4.0.0-beta.106",
		"@repo/typescript-config": "workspace:^",
		"vitest": "4.1.10"
	},
	"dependencies": {
		"@repo/api": "workspace:*",
		"@aws-sdk/client-s3": "^3.888.0",
		"@aws-sdk/lib-storage": "^3.888.0",
		"@effect/platform-bun": "4.0.0-beta.106",
		"@repo/db": "workspace:*",
		"@repo/logger": "workspace:*",
		"@t3-oss/env-core": "^0.13.10",
		"@types/bun": "^1.2.23",
		"discord-api-types": "0.38.53",
		"discord.js": "14.27.0",
		"drizzle-orm": "^0.44.7",
		"effect": "4.0.0-beta.106",
		"meilisearch": "^0.54.0",
		"pg": "^8.16.3",
		"posthog-node": "5.48.1",
		"zod": "^4.2.1"
	}
}
