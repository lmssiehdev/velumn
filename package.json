{
	"name": "discord-indexer-monorepo",
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"turbo": "^2.10.9",
		"typescript": "5.9.2"
	},
	"packageManager": "bun@1.3.0",
	"patchedDependencies": {
		"discord-markdown-parser@1.2.0": "patches/discord-markdown-parser@1.2.0.patch"
	},
	"private": true,
	"scripts": {
		"build": "turbo run build --filter=dashboard-new...",
		"dev": "turbo run dev --filter=dashboard-new --filter=bot",
		"type-check": "turbo run type-check --filter=dashboard-new... --filter=bot...",
		"lint": "turbo run lint --filter=dashboard-new",
		"test": "turbo run test --filter=dashboard-new... --filter=bot...",
		"dev:bot": "turbo run dev --filter=bot",
		"dev:dashboard-new": "turbo run dev --filter=dashboard-new",
		"nuke": "bunx npkill -D -y && rm bun.lock"
	},
	"workspaces": {
		"packages": ["apps/*", "packages/*"],
		"catalog": {
			"react": "19.2.3",
			"react-dom": "19.2.3"
		}
	}
}
