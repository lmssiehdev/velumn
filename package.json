{
  "name": "velumn",
  "private": true,
  "license": "GPL-3.0-only",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter @velumn/server dev",
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check",
    "lint": "effect-tsgo oxlint .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run test",
    "prepare": "effect-tsgo patch --no-typescript --oxlint"
  },
  "devDependencies": {
    "@effect/tsgo": "0.73.2",
    "@types/bun": "latest",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2"
  }
}
