{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"endOfLine": "lf",
	"printWidth": 80,
	"sortPackageJson": false,
	"tabWidth": 2,
	"useTabs": true,
	"ignorePatterns": [
		"**/.next/**",
		"**/.output/**",
		"**/.vercel/**",
		".agents/**",
		"**/dist/**",
		"**/drizzle/**",
		"vendor/**",
		"skills-lock.json",
		"dump/**"
	]
}
